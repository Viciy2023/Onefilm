+  // OneFilm: Dolby Vision output policy. Values mirror
+  // androidx.media3.common.DolbyVisionOutputPolicy from the OneFilm compatibility module.
+  public static final int DV_POLICY_AUTO = 0;
+  public static final int DV_POLICY_PREFER_TUNNELED = 1;
+  public static final int DV_POLICY_PREFER_NON_TUNNELED = 2;
+  public static final int DV_POLICY_ASSUME_SUPPORTED = 3;
+  public static final int DV_POLICY_ASSUME_UNSUPPORTED = 4;
+
+  private static volatile int dolbyVisionOutputPolicy = DV_POLICY_AUTO;
+
+  /**
+   * OneFilm: Sets how Dolby Vision output is handled by this renderer.
+   *
+   * <p>{@link #DV_POLICY_AUTO} keeps the upstream behaviour. {@link
+   * #DV_POLICY_ASSUME_UNSUPPORTED} forces the HEVC base layer to be decoded by rewriting the
+   * input format MIME type. This is useful on devices that report Dolby Vision support but fail
+   * to decode it, or that only expose an HEVC decoder.
+   */
+  public static void setDolbyVisionOutputPolicy(int policy) {
+    int clamped = Math.max(DV_POLICY_AUTO, Math.min(DV_POLICY_ASSUME_UNSUPPORTED, policy));
+    if (clamped != dolbyVisionOutputPolicy) {
+      dolbyVisionOutputPolicy = clamped;
+      Log.i("DolbyVisionPolicy", "output policy=" + clamped);
+    }
+  }
+
+  public static int getDolbyVisionOutputPolicy() {
+    return dolbyVisionOutputPolicy;
+  }
+
+  public static boolean shouldAllowDolbyVisionTunneling(int policy) {
+    return policy != DV_POLICY_PREFER_NON_TUNNELED && policy != DV_POLICY_ASSUME_UNSUPPORTED;
+  }
+
+  public static boolean shouldUseAlternativeDecoderForDolbyVision(Context context, int policy) {
+    if (policy == DV_POLICY_ASSUME_UNSUPPORTED) {
+      return true;
+    }
+    if (policy == DV_POLICY_ASSUME_SUPPORTED) {
+      return false;
+    }
+    return SDK_INT >= 26 && !Api26.doesDisplaySupportDolbyVision(context);
+  }
+
+  /**
+   * OneFilm: Rewrites a Dolby Vision format so the HEVC base layer can be decoded by a regular
+   * HEVC decoder when Dolby Vision output is assumed to be unsupported.
+   */
+  public static Format remapDolbyVisionFormatForUnsupportedOutput(Format format) {
+    if (!MimeTypes.VIDEO_DOLBY_VISION.equals(format.sampleMimeType)) {
+      return format;
+    }
+    return format.buildUpon().setSampleMimeType(MimeTypes.VIDEO_H265).setCodecs(null).build();
+  }
